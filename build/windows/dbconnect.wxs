<?xml version="1.0" encoding="utf-8"?>
<!--
  DbConnect WiX 4 installer
  Build: wix build dbconnect.wxs -d AppVersion=2.0.0 -d SourceDir=path/to/publish -o dbconnect-setup-2.0.0.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="DbConnect"
    Manufacturer="DbConnect"
    Version="$(AppVersion)"
    UpgradeCode="7C3E4F2A-1B8D-4E6A-9F5C-3A2D7E8B0C1F"
    Scope="perMachine">

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of DbConnect is already installed. Please uninstall it first." />

    <Feature Id="Main" Title="DbConnect" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>

  <!-- Installation directory structure -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="DbConnect" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DbConnectMenuDir" Name="DbConnect" />
    </StandardDirectory>
  </Fragment>

  <!-- App files (all files from publish output) -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLDIR">
      <Files Include="$(SourceDir)\**\*.*" />
    </ComponentGroup>
  </Fragment>

  <!-- Start menu shortcut -->
  <Fragment>
    <Component Id="StartMenuShortcut" Directory="DbConnectMenuDir" Guid="C8AF18E4-D5BB-44FD-887F-6AF873D15524">
      <Shortcut
        Id="DbConnectStartMenuShortcut"
        Name="DbConnect"
        Description="DbConnect SQL Editor"
        Target="[INSTALLDIR]DbConnect.exe"
        WorkingDirectory="INSTALLDIR" />
      <RemoveFolder Id="RemoveDbConnectMenuDir" Directory="DbConnectMenuDir" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\DbConnect\Installer"
        Name="StartMenuShortcut"
        Value="1"
        Type="integer"
        KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
