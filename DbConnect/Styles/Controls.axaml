<!-- Looks for the shared EmptyState and SidebarSection controls (DbConnect/Views), inline icons and status dots. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:views="using:DbConnect.Views">

    <Style Selector="views|EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="{DynamicResource DbConnect.Thickness.Dialog}"/>
        <Setter Property="Template">
            <ControlTemplate x:DataType="views:EmptyState">
                <StackPanel Margin="{TemplateBinding Padding}" Spacing="{DynamicResource DbConnect.Space.M}" MaxWidth="360">
                    <fi:SymbolIcon Symbol="{TemplateBinding Icon}" FontSize="{DynamicResource DbConnect.Icon.EmptyState}"
                                   Foreground="{DynamicResource DbConnectMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Classes="heading" Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Classes="muted" Text="{TemplateBinding Message}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding Message, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Button Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding ActionCommand, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="views|SidebarSection">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate x:DataType="views:SidebarSection">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <!-- Its own template: the theme's toggle would fill the expanded (checked) state with the accent. -->
                        <ToggleButton Name="PART_Chevron" DockPanel.Dock="Left"
                                      Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                      Width="{DynamicResource DbConnect.Size.ControlMinHeight}"
                                      Height="{DynamicResource DbConnect.Size.ControlMinHeight}"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ToolTip.Tip="Collapse or expand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Name="ChevronFace" Background="Transparent">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Panel>
                                <fi:SymbolIcon Symbol="ChevronDown" FontSize="{DynamicResource DbConnect.Icon.Inline}"
                                               IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <fi:SymbolIcon Symbol="ChevronRight" FontSize="{DynamicResource DbConnect.Icon.Inline}"
                                               IsVisible="{Binding !IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Panel>
                        </ToggleButton>
                        <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding HeaderActions}"
                                          VerticalAlignment="Center"/>
                        <TextBlock Classes="section-header" Text="{TemplateBinding Header}"
                                   VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      IsVisible="{TemplateBinding IsExpanded}"/>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Icons in a row of text (tab headers, banners). Fluent icons take all the height they are offered, so fix the box too. -->
    <Style Selector="fi|SymbolIcon.inline">
        <Setter Property="FontSize" Value="{DynamicResource DbConnect.Icon.Inline}"/>
        <Setter Property="Width" Value="{DynamicResource DbConnect.Icon.Inline}"/>
        <Setter Property="Height" Value="{DynamicResource DbConnect.Icon.Inline}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Small status dots: unsaved changes and open transaction in a tab header, a connection's label colour. -->
    <Style Selector="Border.status-dot">
        <Setter Property="Width" Value="{DynamicResource DbConnect.Size.Dot}"/>
        <Setter Property="Height" Value="{DynamicResource DbConnect.Size.Dot}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Status-bar badges (Production, error): white caption text on a filled background. -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="{DynamicResource DbConnect.CornerRadius.Control}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge.danger">
        <Setter Property="Background" Value="{DynamicResource DbConnectDangerFillBrush}"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DbConnectOnAccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- The open-transaction marker on a document tab: a gold dot. -->
    <Style Selector="Border.status-dot.transaction">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.IconGold}"/>
    </Style>
    <!-- The status bar's connection dot: green while the active tab is connected, grey otherwise. -->
    <Style Selector="Border.status-dot.connection">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.IconOffline}"/>
    </Style>
    <Style Selector="Border.status-dot.connection.connected">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.IconGreen}"/>
    </Style>
    <!-- The production badge: white semibold caption on the close-button red. -->
    <Style Selector="Border.badge.production">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.CloseHover}"/>
        <Setter Property="Padding" Value="6,0"/>
    </Style>
    <Style Selector="Border.badge.production TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- A small state chip, "dirty" for unsaved or uncommitted work. -->
    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="{DynamicResource DbConnect.CornerRadius.Control}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip.dirty">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.DirtyBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DbConnect.Brush.DirtyBorder}"/>
    </Style>
    <Style Selector="Border.chip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.Text}"/>
    </Style>
    <!-- A destructive menu command (Drop Table…): its label in the delete red. -->
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconRed}"/>
    </Style>

    <!-- A muted inline icon (the search glass inside a filter box). -->
    <Style Selector="fi|SymbolIcon.muted">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.TextMuted}"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <!-- Navigator rows (TreeView.navigator): 15 px icon in the node's role colour (its Tag names the role), label,
         semibold connections and groups, an 8 px colour tag, right-aligned caption meta. -->
    <Style Selector="TreeView.navigator">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,3"/>
    </Style>
    <!-- The row's header fills the row, so the meta can sit at the right edge. -->
    <Style Selector="TreeView.navigator TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="DockPanel.node-row StackPanel">
        <Setter Property="Spacing" Value="6"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon">
        <Setter Property="FontSize" Value="{DynamicResource DbConnect.Icon.Node}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Icons in a palette role colour: a navigator or Objects row icon (node-icon) or a toolbar icon (role), whose Tag
         names the role. Styles rather than brushes, so the colour follows the theme variant. -->
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconGreen], fi|SymbolIcon.role[Tag=IconGreen]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconGreen}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconGold], fi|SymbolIcon.role[Tag=IconGold]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconGold}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconBlue], fi|SymbolIcon.role[Tag=IconBlue]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconBlue}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconPurple], fi|SymbolIcon.role[Tag=IconPurple]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconPurple}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconSlate], fi|SymbolIcon.role[Tag=IconSlate]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconSlate}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconTeal], fi|SymbolIcon.role[Tag=IconTeal]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconTeal}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconOrange], fi|SymbolIcon.role[Tag=IconOrange]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconOrange}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconOffline], fi|SymbolIcon.role[Tag=IconOffline]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconOffline}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconRed], fi|SymbolIcon.role[Tag=IconRed]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconRed}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconBrown], fi|SymbolIcon.role[Tag=IconBrown]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconBrown}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconPink], fi|SymbolIcon.role[Tag=IconPink]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconPink}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconLeaf], fi|SymbolIcon.role[Tag=IconLeaf]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconLeaf}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=Accent], fi|SymbolIcon.role[Tag=Accent]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.Accent}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=TextMuted], fi|SymbolIcon.role[Tag=TextMuted]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.TextMuted}"/>
    </Style>
    <Style Selector="fi|SymbolIcon.node-icon[Tag=IconDisabled], fi|SymbolIcon.role[Tag=IconDisabled]">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconDisabled}"/>
    </Style>
    <!-- A disabled toolbar button's icon is dimmed, whatever its role colour (after the role styles, so it wins). -->
    <Style Selector=":is(Button).toolbar:disabled fi|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconDisabled}"/>
    </Style>
    <!-- Commit and Rollback light up green and red while a transaction is open. -->
    <Style Selector="Button.active fi|SymbolIcon.commit">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconGreen}"/>
    </Style>
    <Style Selector="Button.active fi|SymbolIcon.rollback">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconRed}"/>
    </Style>
    <Style Selector="TextBlock.node-label">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.node-label.emphasis">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.node-meta">
        <Setter Property="FontSize" Value="{DynamicResource DbConnect.FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,6,0"/>
    </Style>
    <Style Selector="Border.tag">
        <Setter Property="Width" Value="{DynamicResource DbConnect.Size.Dot}"/>
        <Setter Property="Height" Value="{DynamicResource DbConnect.Size.Dot}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource DbConnect.CornerRadius.Control}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- The Information pane: panel colour; the subject's 30 px icon beside its name (semibold) and type. -->
    <Style Selector="Border.information-pane">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.Panel}"/>
    </Style>
    <Style Selector="StackPanel.information-subject">
        <Setter Property="Spacing" Value="10"/>
        <Setter Property="Margin" Value="12,12,12,10"/>
    </Style>
    <Style Selector="fi|SymbolIcon.subject">
        <Setter Property="FontSize" Value="{DynamicResource DbConnect.Icon.Subject}"/>
    </Style>
    <Style Selector="TextBlock.subject-name">
        <Setter Property="FontSize" Value="{DynamicResource DbConnect.FontSize.Subheading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Grid.information-item">
        <Setter Property="ColumnSpacing" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- A strip of sub-tabs drawn by a ListBox (the query tab's result strip): the grid-line strip, the selected item
         on the surface with border sides and semibold text, like the sub-tab TabControl. -->
    <Style Selector="ListBox.result-strip">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.GridLine}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DbConnect.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="4,3,4,0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
    </Style>
    <Style Selector="ListBox.result-strip ListBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource DbConnect.Size.SubTab}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,0,0,-1"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.result-strip ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.result-strip ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.GridLine}"/>
    </Style>
    <Style Selector="ListBox.result-strip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DbConnect.Brush.Border}"/>
    </Style>
    <Style Selector="ListBox.result-strip ListBoxItem:selected TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- A segmented switch: toolbar toggle buttons joined into one control with an input border. -->
    <Style Selector="StackPanel.segmented">
        <Setter Property="Spacing" Value="0"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>
    <Style Selector="StackPanel.segmented > ToggleButton.toolbar">
        <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DbConnect.Brush.InputBorder}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="StackPanel.segmented > ToggleButton.toolbar:nth-child(1)">
        <Setter Property="CornerRadius" Value="3,0,0,3"/>
    </Style>
    <Style Selector="StackPanel.segmented > ToggleButton.toolbar:nth-last-child(1)">
        <Setter Property="CornerRadius" Value="0,3,3,0"/>
        <Setter Property="Margin" Value="-1,0,0,0"/>
    </Style>

    <!-- A failed statement's error in the Messages grid: a link in the delete red. -->
    <Style Selector="Button.link.error">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconRed}"/>
    </Style>
    <Style Selector="Button.link.error:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.IconRed}"/>
    </Style>
    <!-- SQL in grid cells (the Messages grid's Statement column): the code font. -->
    <Style Selector="DataGridCell.code">
        <Setter Property="FontFamily" Value="{DynamicResource DbConnect.FontFamily.Code}"/>
    </Style>

    <!-- Numeric grid cells (CellStyleClasses="number"): right-aligned. -->
    <Style Selector="DataGridCell.number">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- Objects rows: icon and name. -->
    <Style Selector="StackPanel.object-name">
        <Setter Property="Spacing" Value="6"/>
    </Style>
</Styles>
