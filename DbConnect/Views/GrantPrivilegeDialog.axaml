<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DbConnect.Views.GrantPrivilegeDialog"
        Title="Grant Privilege"
        Width="440" Height="260" MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="{DynamicResource DbConnect.Thickness.Dialog}">
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel>
                <Button Classes="primary" Content="Grant" Click="Grant_Click" IsDefault="True"/>
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
        <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="Privilege:"/>
            <ComboBox Grid.Column="1" Name="PrivilegeBox" HorizontalAlignment="Stretch"/>
            <TextBlock Grid.Row="1" Text="Object:"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="ObjectBox" Watermark="e.g. public.orders"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="caption muted" TextWrapping="Wrap"
                       Text="Optional: leave blank for the provider's default."/>
            <TextBlock Grid.Row="3" Grid.Column="1" Name="PreviewText" Classes="code caption muted" TextWrapping="Wrap"/>
        </Grid>
    </DockPanel>
</Window>
