<!-- The query tab (the design's QueryEditor artboard): toolbar, notices, the SQL editor, a splitter, then the result
     strip (Messages, Result 1…N, Profile, Status, Explain, Chart) over its pane, and a footer with the executed SQL,
     time, rows and fetch actions. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbConnect.ViewModels"
             xmlns:views="using:DbConnect.Views"
             xmlns:svc="using:DbConnect.Services"
             xmlns:models="using:DbConnect.Models"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:fi="using:FluentIcons.Avalonia"
             x:Class="DbConnect.Views.QueryTabView"
             x:DataType="vm:QueryTabViewModel">
    <Grid RowDefinitions="Auto,Auto,*,5,*">
        <views:QueryToolbarView Grid.Row="0" Name="QueryToolbar"/>

        <!-- Notices under the toolbar, one style: file changed on disk, connection lost, USE moved the session. -->
        <StackPanel Grid.Row="1" Name="Banners">
            <Border Name="FileStateBanner" Classes="banner notice" IsVisible="{Binding HasFileStateMessage}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Reload"
                                IsVisible="{Binding IsFileChangedOnDisk}"
                                ToolTip.Tip="Load the file from disk, discarding your edits"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.Monitor.ReloadCommand}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Keep Mine"
                                IsVisible="{Binding IsFileChangedOnDisk}"
                                ToolTip.Tip="Keep your edits; saving will ask before overwriting the newer file"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.Monitor.KeepMineCommand}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                    <fi:SymbolIcon Classes="inline" Symbol="DocumentText"/>
                    <TextBlock Text="{Binding FileStateMessage}"/>
                </DockPanel>
            </Border>
            <Border Name="ConnectionLostBanner" Classes="banner notice" IsVisible="{Binding ConnectionLoss.IsLost}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Reconnect"
                                IsEnabled="{Binding !ConnectionLoss.IsReconnecting}"
                                Command="{Binding ConnectionLoss.ReconnectCommand}"/>
                        <Button Classes="toolbar icon" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss"
                                Command="{Binding ConnectionLoss.DismissCommand}">
                            <fi:SymbolIcon Classes="inline" Symbol="Dismiss"/>
                        </Button>
                    </StackPanel>
                    <fi:SymbolIcon Classes="inline" Symbol="PlugDisconnected"/>
                    <TextBlock Text="{Binding ConnectionLoss.Message}"/>
                </DockPanel>
            </Border>
            <Border Name="UseBanner" Classes="banner notice"
                    IsVisible="{Binding DatabasePicker.InSessionDatabase, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel>
                    <fi:SymbolIcon Classes="inline" Symbol="Database"/>
                    <TextBlock Text="{Binding DatabasePicker.InSessionDatabase, StringFormat='A USE statement moved this session to {0}.'}"/>
                </DockPanel>
            </Border>
            <Border Name="PickerNotice" Classes="banner notice"
                    IsVisible="{Binding DatabasePicker.Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel>
                    <fi:SymbolIcon Classes="inline" Symbol="Info"/>
                    <TextBlock Text="{Binding DatabasePicker.Notice}"/>
                </DockPanel>
            </Border>
            <Border Name="FileNotice" Classes="banner notice"
                    IsVisible="{Binding Document.Notice, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                    ToolTip.Tip="{Binding Document.Notice}">
                <DockPanel>
                    <fi:SymbolIcon Classes="inline" Symbol="Info"/>
                    <TextBlock Text="{Binding Document.Encoding.WebName, StringFormat='Encoding: {0}'}"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <views:FindReplaceBar Name="EditorSearch"/>
            <ae:TextEditor Name="QueryEditor" Grid.Row="1"
                       Background="{DynamicResource DbConnectCodeBgBrush}"
                       Foreground="{DynamicResource DbConnectCodeFgBrush}"
                       FontFamily="{DynamicResource DbConnect.FontFamily.Code}"
                       ShowLineNumbers="True"
                       IsReadOnly="{Binding IsReadOnly}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
        </Grid>

        <GridSplitter Grid.Row="3" ResizeDirection="Rows" />

        <DockPanel Grid.Row="4">
            <!-- The result strip, in the sub-tab style. -->
            <ListBox DockPanel.Dock="Top" Name="ResultStrip" Classes="result-strip"
                     ItemsSource="{Binding Panes.Items}" SelectedItem="{Binding Panes.Selected}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultPane">
                        <TextBlock Text="{Binding Header}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer: executed SQL | read only | query time | rows | fetch actions. -->
            <Border DockPanel.Dock="Bottom" Name="ResultFooter" Classes="result-footer">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Name="FooterReadOnly" Text="Read only"
                                   IsVisible="{Binding ResultEditor.ReadOnlyReason, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   ToolTip.Tip="{Binding ResultEditor.ReadOnlyReason}"/>
                        <TextBlock Name="FooterTime" Text="{Binding Panes.FooterTimeText}"
                                   IsVisible="{Binding Panes.FooterTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Name="FooterRows" Text="{Binding Panes.FooterRowsText}"
                                   IsVisible="{Binding Panes.FooterRowsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Button Classes="toolbar icon" Name="FetchNextButton" Command="{Binding Paging.FetchNextCommand}"
                                IsEnabled="{Binding Paging.HasMore}"
                                ToolTip.Tip="Fetch next: read the next page of rows from the open result" AutomationProperties.Name="Fetch next">
                            <fi:SymbolIcon Symbol="ArrowDown"/>
                        </Button>
                        <Button Classes="toolbar icon" Command="{Binding Paging.FetchAllCommand}" IsEnabled="{Binding Paging.HasMore}"
                                ToolTip.Tip="Fetch all: read the remaining rows, up to the limit in Preferences" AutomationProperties.Name="Fetch all">
                            <fi:SymbolIcon Symbol="ArrowCircleDown"/>
                        </Button>
                        <Button Classes="toolbar icon" Command="{Binding Paging.StopFetchingCommand}" IsVisible="{Binding Paging.IsFetching}"
                                ToolTip.Tip="Stop reading rows" AutomationProperties.Name="Stop reading">
                            <fi:SymbolIcon Symbol="Stop"/>
                        </Button>
                    </StackPanel>
                    <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" IsVisible="{Binding IsExecuting}" Width="60"/>
                    <TextBlock Name="ResultSummaryText" Classes="code" Text="{Binding Panes.FooterSqlText}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ResultSummary}"/>
                </DockPanel>
            </Border>

            <Panel>
                <!-- Messages: one row per statement. -->
                <Grid Name="MessagesPane" IsVisible="{Binding Panes.IsMessages}">
                    <DataGrid Name="MessagesGrid" ItemsSource="{Binding MessagesRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding StatementNumber}" Width="Auto" CellStyleClasses="number"/>
                            <DataGridTextColumn Header="Statement" Binding="{Binding Statement}" Width="3*" CellStyleClasses="code"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="Auto" CellStyleClasses="number"/>
                            <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="Auto" CellStyleClasses="number"/>
                            <DataGridTemplateColumn Header="Result" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:QueryMessageRow">
                                        <Panel>
                                            <TextBlock Text="OK" IsVisible="{Binding !HasError}" VerticalAlignment="Center"/>
                                            <Button Classes="link error" Content="{Binding Error}" Command="{Binding NavigateErrorCommand}"
                                                    IsVisible="{Binding HasError}" HorizontalAlignment="Left"
                                                    ToolTip.Tip="Show this statement in the editor"/>
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Warnings / notices" Binding="{Binding Warnings}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <views:EmptyState Icon="TextBulletList" Title="No messages yet"
                                      Message="Run a query; each statement's rows, duration, notices and errors are listed here."
                                      IsVisible="{Binding !MessagesRows.Count}"/>
                </Grid>

                <!-- A result set: its toolbar, the export options, then the grid or Form View. -->
                <DockPanel Name="ResultPane" IsVisible="{Binding Panes.IsResult}">
                    <Border DockPanel.Dock="Top" Classes="toolbar" IsVisible="{Binding CanCopyResults}">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Classes="field" Text="{Binding ResultFilterText}" Watermark="Filter rows…"
                                         AutomationProperties.Name="Filter rows">
                                    <TextBox.InnerLeftContent>
                                        <fi:SymbolIcon Classes="inline muted" Symbol="Filter"/>
                                    </TextBox.InnerLeftContent>
                                    <TextBox.InnerRightContent>
                                        <Button Classes="toolbar icon" Command="{Binding ClearResultFilterCommand}" ToolTip.Tip="Clear filter"
                                                AutomationProperties.Name="Clear filter">
                                            <fi:SymbolIcon Classes="inline" Symbol="Dismiss"/>
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                                <Button Classes="toolbar" ToolTip.Tip="Show or hide result columns">
                                    <StackPanel>
                                        <fi:SymbolIcon Symbol="ColumnTriple"/>
                                        <TextBlock Text="Columns"/>
                                        <fi:SymbolIcon Classes="caret" Symbol="ChevronDown"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" Margin="8" Width="220">
                                    <Button Content="Show All" Command="{Binding ResultGrid.ShowAllColumnsCommand}" HorizontalAlignment="Left"/>
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsControl ItemsSource="{Binding ResultGrid.Columns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ResultColumnToggle">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Classes="toolbar" ToolTip.Tip="Sort the loaded rows">
                                    <StackPanel>
                                        <fi:SymbolIcon Symbol="ArrowSort"/>
                                        <TextBlock Text="Sort"/>
                                        <fi:SymbolIcon Classes="caret" Symbol="ChevronDown"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" Margin="8" Width="240">
                                    <TextBlock Classes="section-header" Text="Sort"/>
                                    <ComboBox ItemsSource="{Binding ResultColumns}"
                                              SelectedItem="{Binding ResultSortColumn}"
                                              Width="200"
                                              ToolTip.Tip="Column used for client-side sorting"/>
                                    <ToggleButton IsChecked="{Binding ResultSortDescending}"
                                                  Content="Descending"
                                                  Width="120"/>
                                </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <ToggleButton Classes="toolbar" IsChecked="{Binding Record.IsActive, Mode=OneWay}"
                                              Command="{Binding Record.ToggleCommand}"
                                              ToolTip.Tip="Form View: show one row at a time as name/value pairs">
                                    <StackPanel>
                                        <fi:SymbolIcon Symbol="Form"/>
                                        <TextBlock Text="Form View"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Separator/>
                                <Button Classes="toolbar" ToolTip.Tip="Copy settings and Copy All">
                                    <StackPanel>
                                        <fi:SymbolIcon Symbol="Copy"/>
                                        <TextBlock Text="Copy"/>
                                        <fi:SymbolIcon Classes="caret" Symbol="ChevronDown"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" Margin="8" Width="240">
                                    <TextBlock Classes="section-header" Text="Copy"/>
                                    <CheckBox Content="Include header" IsChecked="{Binding ResultGrid.IncludeHeader}"/>
                                    <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="Delimiter:"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ResultGrid.DelimiterOptions}"
                                                  SelectedItem="{Binding ResultGrid.Delimiter}"
                                                  HorizontalAlignment="Stretch"/>
                                        <TextBlock Grid.Row="1" Text="Quote:"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ResultGrid.QuoteOptions}"
                                                  SelectedItem="{Binding ResultGrid.Quote}"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Quote values that contain the delimiter, the quote or a line break"/>
                                    </Grid>
                                    <CheckBox Content="Always quote" IsChecked="{Binding ResultGrid.AlwaysQuote}"
                                              ToolTip.Tip="Quote every header and value, not only those that need it"/>
                                    <CheckBox Content="Values as SQL literals" IsChecked="{Binding ResultGrid.SqlLiterals}"
                                              ToolTip.Tip="Copy values as 'text', 42 and NULL, ready to paste into SQL"/>
                                    <Button Content="Copy All" Click="CopyAll_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Classes="toolbar" ToolTip.Tip="Export the result">
                                    <StackPanel>
                                        <fi:SymbolIcon Classes="role" Tag="IconTeal" Symbol="ArrowExport"/>
                                        <TextBlock Text="Export"/>
                                        <fi:SymbolIcon Classes="caret" Symbol="ChevronDown"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="Export CSV…" Click="ExportCsv_Click"/>
                                            <MenuItem Header="Export Options…" Command="{Binding ToggleExportOptionsPanelCommand}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <CheckBox Content="Edit by matching all column values"
                                          IsChecked="{Binding ResultEditor.AllowAllColumnIdentity}"
                                          IsVisible="{Binding ResultEditor.OffersAllColumnIdentity}"
                                          ToolTip.Tip="The table has no usable primary key. Each update or delete must match exactly one row; identical rows make the commit fail and roll back."/>
                                <TextBlock Text="{Binding TruncationSummary}" Classes="warning-text"
                                           IsVisible="{Binding !Paging.HasMore}"/>
                                <TextBlock Text="{Binding Paging.Summary}" Classes="warning-text"
                                           IsVisible="{Binding Paging.Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding ResultEditor.StatusMessage}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- Read-only / Editable: which the result is; the reason is in the tooltip. -->
                                <StackPanel Name="EditModeSwitch" Classes="segmented" Orientation="Horizontal"
                                            ToolTip.Tip="{Binding ResultEditor.ReadOnlyReason, TargetNullValue='Double-click a cell to edit it. Edits are saved only when you commit them.'}">
                                    <ToggleButton Classes="toolbar" Content="Read-only" IsHitTestVisible="False"
                                                  IsChecked="{Binding !ResultEditor.IsEditable, Mode=OneWay}"/>
                                    <ToggleButton Classes="toolbar" Content="Editable" IsHitTestVisible="False"
                                                  IsChecked="{Binding ResultEditor.IsEditable, Mode=OneWay}"/>
                                </StackPanel>
                                <Button Classes="toolbar" Command="{Binding ResultEditor.RequestCommitCommand}"
                                        IsVisible="{Binding ResultEditor.IsEditable}" ToolTip.Tip="Preview and commit the edited rows">
                                    <StackPanel>
                                        <fi:SymbolIcon Classes="role" Tag="IconGreen" Symbol="Save"/>
                                        <TextBlock Text="Commit…"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="toolbar" Command="{Binding ResultEditor.DiscardChangesCommand}"
                                        IsVisible="{Binding ResultEditor.IsEditable}" ToolTip.Tip="Discard all pending edits">
                                    <StackPanel>
                                        <fi:SymbolIcon Symbol="ArrowUndo"/>
                                        <TextBlock Text="Discard"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
            <Border DockPanel.Dock="Top" Classes="toolbar"
                    IsVisible="{Binding ShowExportOptionsPanel}">
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                    <TextBlock Text="Format:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ExportFormatOptions}"
                              SelectedItem="{Binding ExportOptions.Format}"
                              Width="80"/>
                    <TextBlock IsVisible="{Binding ExportOptions.UsesTextOptions}" Text="Delimiter:" VerticalAlignment="Center"/>
                    <ComboBox IsVisible="{Binding ExportOptions.UsesTextOptions}" ItemsSource="{Binding DelimiterOptions}"
                              SelectedItem="{Binding ExportOptions.Delimiter}"
                              Width="90"/>
                    <TextBlock IsVisible="{Binding ExportOptions.UsesTextOptions}" Text="Nulls:" VerticalAlignment="Center"/>
                    <ComboBox IsVisible="{Binding ExportOptions.UsesTextOptions}" ItemsSource="{Binding NullRepOptions}"
                              SelectedItem="{Binding ExportOptions.NullRepresentation}"
                              Width="100"/>
                    <TextBlock IsVisible="{Binding ExportOptions.IsSqlInsert}" Text="Table:" VerticalAlignment="Center"/>
                    <TextBox Name="SqlInsertTableName" IsVisible="{Binding ExportOptions.IsSqlInsert}" Text="{Binding ExportOptions.SqlTableName}"
                             Watermark="Source table, else exported_result" Width="200"
                             ToolTip.Tip="Written into the script as typed; leave blank for the result's single source table, else exported_result"/>
                    <TextBlock IsVisible="{Binding ExportOptions.IsSqlInsert}" Text="Rows per INSERT:" VerticalAlignment="Center"/>
                    <NumericUpDown Name="SqlInsertRowsPerStatement" IsVisible="{Binding ExportOptions.IsSqlInsert}" Value="{Binding ExportOptions.RowsPerStatement}"
                                   Minimum="1" Maximum="100000" Increment="1" FormatString="0" Width="120"
                                   ToolTip.Tip="1 writes one INSERT per row; more writes multi-row VALUES lists, capped where the database limits their size"/>
                    <CheckBox Name="SqlInsertColumnList" IsVisible="{Binding ExportOptions.IsSqlInsert}" Content="Column list"
                              IsChecked="{Binding ExportOptions.IncludeColumnList}" VerticalAlignment="Center"/>
                    <ComboBox Name="QueryExportScopePicker" ItemsSource="{Binding ExportScopes}" SelectedItem="{Binding ExportScope}" Width="180"/>
                    <TextBlock Name="QueryExportScopeExplanation" Text="{Binding ExportScopeExplanation}" MaxWidth="340" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Name="ExportOutcomeText" Text="{Binding ExportState.Message}" MaxWidth="400" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <ProgressBar Name="ExportProgress" IsIndeterminate="True" Width="60" IsVisible="{Binding ExportState.IsRunning}"/>
                    <Button Name="CancelExportButton" Content="Cancel export" Command="{Binding ExportState.CancelCommand}" IsVisible="{Binding ExportState.IsRunning}"/>
                    <CheckBox IsVisible="{Binding ExportOptions.UsesTextOptions}" Content="Include Headers" IsChecked="{Binding ExportOptions.IncludeHeaders}" VerticalAlignment="Center"/>
                    <Button Classes="toolbar" Command="{Binding ExportCommand}" ToolTip.Tip="Export the result with these options">
                        <StackPanel>
                            <fi:SymbolIcon Symbol="ArrowDownload"/>
                            <TextBlock Text="Export…"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

                    <TextBlock DockPanel.Dock="Top" Classes="caption muted" Text="{Binding ResultTabsSummary}" Margin="8,4"
                               IsVisible="{Binding ResultTabsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Grid>
                        <views:RecordView DataContext="{Binding Record}" IsVisible="{Binding IsActive}"/>
                        <DataGrid Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  views:GridEditMenu.Mode="Query"
                                  IsVisible="{Binding !Record.IsActive}"
                                  GridLinesVisibility="All" BorderBrush="{DynamicResource DbConnectBorderBrush}" BorderThickness="1"
                                  CanUserResizeColumns="True"
                                  ToolTip.Tip="{Binding ResultEditor.ReadOnlyReason}">
                            <DataGrid.ContextMenu>
                                <ContextMenu Opening="ResultsMenu_Opening">
                                    <MenuItem Header="Set Cell to NULL"
                                              IsVisible="{Binding ResultEditor.IsEditable}"
                                              Click="SetCellNull_Click"/>
                                    <MenuItem x:Name="ViewValueMenuItem" Header="View Value…"
                                              Click="ViewValue_Click"/>
                                    <MenuItem Header="Copy Cell"
                                              Click="CopyCell_Click"/>
                                    <MenuItem Header="Copy Selected Rows"
                                              Click="CopySelectedRows_Click"/>
                                    <MenuItem Header="Copy All"
                                              Click="CopyAll_Click"/>
                                    <MenuItem Header="Export CSV"
                                              Click="ExportCsv_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <TextBlock Text="{Binding CurrentResult.ErrorMessage}"
                                   Foreground="{DynamicResource DbConnectDangerBrush}"
                                   IsVisible="{Binding CurrentResult.HasError}"
                                   TextWrapping="Wrap" Margin="8"/>
                    </Grid>
                </DockPanel>

                <views:EmptyState Name="ProfilePane" IsVisible="{Binding Panes.IsProfile}" Icon="DataUsage" Title="Profile"
                                  Message="The time each execution stage took will appear here. Not available yet."/>
                <views:EmptyState Name="StatusPane" IsVisible="{Binding Panes.IsStatus}" Icon="DataBarVertical" Title="Status"
                                  Message="The server's status counters for the run will appear here. Not available yet."/>

                <!-- Explain: the execution plan as a diagram or as text, with Run ANALYZE. -->
                <DockPanel Name="ExplainPane" IsVisible="{Binding Panes.IsExplain}">
                    <Border DockPanel.Dock="Top" Classes="toolbar">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Classes="section-header" Text="Execution Plan"/>
                            <StackPanel Classes="segmented" Orientation="Horizontal">
                                <ToggleButton Classes="toolbar" Content="Diagram" IsChecked="{Binding !Panes.IsPlanText, Mode=OneWay}"
                                              Command="{Binding Panes.ShowDiagramCommand}"/>
                                <ToggleButton Classes="toolbar" Content="Text" IsChecked="{Binding Panes.IsPlanText, Mode=OneWay}"
                                              Command="{Binding Panes.ShowTextCommand}"/>
                            </StackPanel>
                            <CheckBox Content="Run ANALYZE"
                                      IsChecked="{Binding AllowAnalyze}"
                                      IsVisible="{Binding SupportsAnalyzeExplain}"
                                      ToolTip.Tip="Execute the query to collect real timings"/>
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsExplaining}" Width="60"/>
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Classes="banner info"
                            IsVisible="{Binding ShowAnalyzeBanner}">
                        <DockPanel>
                            <Button Classes="toolbar icon" DockPanel.Dock="Right"
                                    Command="{Binding DismissBannerCommand}"
                                    ToolTip.Tip="Dismiss">
                                <fi:SymbolIcon Symbol="Dismiss"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fi:SymbolIcon Symbol="Info" FontSize="{DynamicResource DbConnect.Icon.Inline}" VerticalAlignment="Center"/>
                                <TextBlock Text="ANALYZE executes the query against the live database to collect real timing data."
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                    <!-- Structured explain plan (shown when parsed plan has children) -->
                    <views:ExplainPlanView x:DataType="vm:ExplainPlanViewModel"
                                           DataContext="{Binding ExplainPlan}"
                                           IsVisible="{Binding $parent[views:QueryTabView].((vm:QueryTabViewModel)DataContext).Panes.ShowPlanDiagram}"/>

                    <!-- Raw explain data grid (fallback) -->
                    <DataGrid Name="ExplainGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="All" BorderBrush="{DynamicResource DbConnectBorderBrush}" BorderThickness="1"
                              CanUserResizeColumns="True"
                              IsVisible="{Binding Panes.ShowPlanText}"/>

                    <TextBlock Text="{Binding ExplainResult.ErrorMessage}"
                               Foreground="{DynamicResource DbConnectDangerBrush}"
                               IsVisible="{Binding ExplainResult.HasError}"
                               TextWrapping="Wrap" Margin="8"/>
                        <views:EmptyState Icon="Organization" Title="No plan yet"
                                          Message="Run Explain (Ctrl+E) to see how the database will execute the query."
                                          IsVisible="{Binding ExplainResult, Converter={x:Static ObjectConverters.IsNull}}"/>
                    </Grid>
                </DockPanel>

                <Panel Name="ChartPane" IsVisible="{Binding Panes.IsChart}">
                    <views:ResultChartView DataContext="{Binding Chart}"/>
                </Panel>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
