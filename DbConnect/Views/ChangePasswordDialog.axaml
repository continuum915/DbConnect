<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DbConnect.Views.ChangePasswordDialog"
        Title="Change Password"
        Width="420" Height="240" MinWidth="360" MinHeight="220"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="{DynamicResource DbConnect.Thickness.Dialog}">
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel>
                <Button Classes="primary" Content="Update" Click="Update_Click" IsDefault="True"/>
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
        <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="User:"/>
            <TextBlock Grid.Column="1" Name="UsernameText" FontWeight="{DynamicResource DbConnect.FontWeight.Subheading}"/>
            <TextBlock Grid.Row="1" Text="New password:"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="PasswordBox" PasswordChar="•" Watermark="Enter new password"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Name="PreviewText" Classes="code caption muted" TextWrapping="Wrap"/>
        </Grid>
    </DockPanel>
</Window>
