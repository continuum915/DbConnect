<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbConnect.ViewModels"
        xmlns:models="using:DbConnect.Models"
        x:Class="DbConnect.Views.SupportBundleDialog"
        x:DataType="vm:SupportBundleViewModel"
        Title="Support Bundle Preview"
        Width="820" Height="600" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <!-- Shows the in-memory, redacted draft so it can be reviewed before the archive is saved. -->
    <DockPanel Margin="{DynamicResource DbConnect.Thickness.Dialog}">
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <DockPanel>
                <TextBlock Classes="muted" Text="{Binding StatusMessage}"/>
                <StackPanel>
                    <Button Classes="primary" Content="Save Bundle…" Click="Save_Click" IsDefault="True"/>
                    <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Review the redacted support-bundle files before saving or sharing them."/>

        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
            <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SupportBundleEntry">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" BorderBrush="{DynamicResource DbConnectBorderBrush}" BorderThickness="1" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox Classes="code" Text="{Binding SelectedContent, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
