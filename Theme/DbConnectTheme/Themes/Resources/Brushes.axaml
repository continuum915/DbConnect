      <SolidColorBrush x:Key="DbConnect.Brush.SqlFunction" Color="{DynamicResource DbConnect.Color.SqlFunction}" />
      <SolidColorBrush x:Key="DbConnect.Brush.SqlString" Color="{DynamicResource DbConnect.Color.SqlString}" />
      <SolidColorBrush x:Key="DbConnect.Brush.SqlNumber" Color="{DynamicResource DbConnect.Color.SqlNumber}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
