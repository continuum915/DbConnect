<!-- One solid brush per palette colour. Brushes live in the theme dictionaries so their DynamicResource colours
     resolve for the requesting control's theme variant; outside them a brush keeps the application variant's colours. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="DbConnect.Brush.Desk" Color="{DynamicResource DbConnect.Color.Desk}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Window" Color="{DynamicResource DbConnect.Color.Window}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Surface" Color="{DynamicResource DbConnect.Color.Surface}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Button" Color="{DynamicResource DbConnect.Color.Button}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Panel" Color="{DynamicResource DbConnect.Color.Panel}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Toolbar" Color="{DynamicResource DbConnect.Color.Toolbar}" />
      <SolidColorBrush x:Key="DbConnect.Brush.GridHeader" Color="{DynamicResource DbConnect.Color.GridHeader}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Chrome" Color="{DynamicResource DbConnect.Color.Chrome}" />
      <SolidColorBrush x:Key="DbConnect.Brush.TitleBar" Color="{DynamicResource DbConnect.Color.TitleBar}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Splitter" Color="{DynamicResource DbConnect.Color.Splitter}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Disabled" Color="{DynamicResource DbConnect.Color.Disabled}" />
      <SolidColorBrush x:Key="DbConnect.Brush.GridLine" Color="{DynamicResource DbConnect.Color.GridLine}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Divider" Color="{DynamicResource DbConnect.Color.Divider}" />
      <SolidColorBrush x:Key="DbConnect.Brush.BorderSoft" Color="{DynamicResource DbConnect.Color.BorderSoft}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Separator" Color="{DynamicResource DbConnect.Color.Separator}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Border" Color="{DynamicResource DbConnect.Color.Border}" />
      <SolidColorBrush x:Key="DbConnect.Brush.FieldBorder" Color="{DynamicResource DbConnect.Color.FieldBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.InputBorder" Color="{DynamicResource DbConnect.Color.InputBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.ButtonBorder" Color="{DynamicResource DbConnect.Color.ButtonBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.DialogBorder" Color="{DynamicResource DbConnect.Color.DialogBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.PressedBg" Color="{DynamicResource DbConnect.Color.PressedBg}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Text" Color="{DynamicResource DbConnect.Color.Text}" />
      <SolidColorBrush x:Key="DbConnect.Brush.TextSecondary" Color="{DynamicResource DbConnect.Color.TextSecondary}" />
      <SolidColorBrush x:Key="DbConnect.Brush.TextMuted" Color="{DynamicResource DbConnect.Color.TextMuted}" />
      <SolidColorBrush x:Key="DbConnect.Brush.TextNull" Color="{DynamicResource DbConnect.Color.TextNull}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconDisabled" Color="{DynamicResource DbConnect.Color.IconDisabled}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconOffline" Color="{DynamicResource DbConnect.Color.IconOffline}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Accent" Color="{DynamicResource DbConnect.Color.Accent}" />
      <SolidColorBrush x:Key="DbConnect.Brush.HoverBg" Color="{DynamicResource DbConnect.Color.HoverBg}" />
      <SolidColorBrush x:Key="DbConnect.Brush.HoverBorder" Color="{DynamicResource DbConnect.Color.HoverBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.ButtonHoverBorder" Color="{DynamicResource DbConnect.Color.ButtonHoverBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.CheckedBg" Color="{DynamicResource DbConnect.Color.CheckedBg}" />
      <SolidColorBrush x:Key="DbConnect.Brush.CheckedBorder" Color="{DynamicResource DbConnect.Color.CheckedBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Selection" Color="{DynamicResource DbConnect.Color.Selection}" />
      <SolidColorBrush x:Key="DbConnect.Brush.RowHover" Color="{DynamicResource DbConnect.Color.RowHover}" />
      <SolidColorBrush x:Key="DbConnect.Brush.CurrentRow" Color="{DynamicResource DbConnect.Color.CurrentRow}" />
      <SolidColorBrush x:Key="DbConnect.Brush.CurrentLine" Color="{DynamicResource DbConnect.Color.CurrentLine}" />
      <SolidColorBrush x:Key="DbConnect.Brush.TileBorder" Color="{DynamicResource DbConnect.Color.TileBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.DirtyBg" Color="{DynamicResource DbConnect.Color.DirtyBg}" />
      <SolidColorBrush x:Key="DbConnect.Brush.DirtyBorder" Color="{DynamicResource DbConnect.Color.DirtyBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.NewRowBg" Color="{DynamicResource DbConnect.Color.NewRowBg}" />
      <SolidColorBrush x:Key="DbConnect.Brush.RunBg" Color="{DynamicResource DbConnect.Color.RunBg}" />
      <SolidColorBrush x:Key="DbConnect.Brush.RunBorder" Color="{DynamicResource DbConnect.Color.RunBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.RunHoverBg" Color="{DynamicResource DbConnect.Color.RunHoverBg}" />
      <SolidColorBrush x:Key="DbConnect.Brush.RunHoverBorder" Color="{DynamicResource DbConnect.Color.RunHoverBorder}" />
      <SolidColorBrush x:Key="DbConnect.Brush.SuccessText" Color="{DynamicResource DbConnect.Color.SuccessText}" />
