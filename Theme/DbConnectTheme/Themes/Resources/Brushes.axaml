      <SolidColorBrush x:Key="DbConnect.Brush.IconTeal" Color="{DynamicResource DbConnect.Color.IconTeal}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconOrange" Color="{DynamicResource DbConnect.Color.IconOrange}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconGold" Color="{DynamicResource DbConnect.Color.IconGold}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconRed" Color="{DynamicResource DbConnect.Color.IconRed}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconPurple" Color="{DynamicResource DbConnect.Color.IconPurple}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconBrown" Color="{DynamicResource DbConnect.Color.IconBrown}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconSlate" Color="{DynamicResource DbConnect.Color.IconSlate}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconPink" Color="{DynamicResource DbConnect.Color.IconPink}" />
      <SolidColorBrush x:Key="DbConnect.Brush.IconLeaf" Color="{DynamicResource DbConnect.Color.IconLeaf}" />
      <SolidColorBrush x:Key="DbConnect.Brush.SqlKeyword" Color="{DynamicResource DbConnect.Color.SqlKeyword}" />
      <SolidColorBrush x:Key="DbConnect.Brush.SqlFunction" Color="{DynamicResource DbConnect.Color.SqlFunction}" />
      <SolidColorBrush x:Key="DbConnect.Brush.SqlString" Color="{DynamicResource DbConnect.Color.SqlString}" />
      <SolidColorBrush x:Key="DbConnect.Brush.SqlNumber" Color="{DynamicResource DbConnect.Color.SqlNumber}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="DbConnect.Brush.Desk" Color="{DynamicResource DbConnect.Color.Desk}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Window" Color="{DynamicResource DbConnect.Color.Window}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Surface" Color="{DynamicResource DbConnect.Color.Surface}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Button" Color="{DynamicResource DbConnect.Color.Button}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Panel" Color="{DynamicResource DbConnect.Color.Panel}" />
      <SolidColorBrush x:Key="DbConnect.Brush.Toolbar" Color="{DynamicResource DbConnect.Color.Toolbar}" />
      <SolidColorBrush x:Key="DbConnect.Brush.GridHeader" Color="{DynamicResource DbConnect.Color.GridHeader}" />
