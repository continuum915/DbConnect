<!-- Lists: surface with a border; rows use the row hover and light selection (FluentOverrides.axaml). -->
<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbConnect.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.Text}" />
  </Style>
</Styles>
