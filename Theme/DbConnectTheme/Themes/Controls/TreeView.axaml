<!-- Trees: 22 px rows (DbConnect/Styles/Global.axaml), 14 px indent, a 16 px muted chevron, row hover and light
     selection with ordinary text (FluentOverrides.axaml). -->
<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="TreeView">
    <Setter Property="Background" Value="{DynamicResource DbConnect.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbConnect.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
    <Setter Property="Width" Value="16" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource DbConnect.Brush.TextMuted}" />
  </Style>
</Styles>
