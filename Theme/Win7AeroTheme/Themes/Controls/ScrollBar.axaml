<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource Win7.Brush.Track}" />
    <Setter Property="Foreground" Value="{DynamicResource Win7.Brush.ControlFace}" />
  </Style>
  <Style Selector="ScrollBar:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Win7.Brush.ControlFaceHover}" />
  </Style>
</Styles>
